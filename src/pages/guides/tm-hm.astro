];

interface Hm extends Machine {
  badge: string;
}

const hms: Hm[] = [
  { no: 'HM01', move: 'cut', obtain: '桐树林：帮烧炭师傅追回大葱鸭后赠送', badge: '昆虫徽章' },
  { no: 'HM02', move: 'fly', obtain: '湛蓝市：战胜阿四后与道馆外他的妻子对话赠送', badge: '打击徽章' },
  { no: 'HM03', move: 'surf', obtain: '圆朱市歌舞练习场：击败台上的火箭队队员后老板赠送', badge: '魅影徽章' },
  { no: 'HM04', move: 'strength', obtain: '浅葱市食堂：与店内的水手对话赠送', badge: '标准徽章' },
  { no: 'HM05', move: 'flash', obtain: '喇叭芽之塔 3F：战胜长老后赠送', badge: '飞翼徽章' },
  { no: 'HM06', move: 'whirlpool', obtain: '火箭队基地地下 2 层：电极怪事件后阿渡赠送', badge: '冰冻徽章' },
  { no: 'HM07', move: 'waterfall', obtain: '冰雪小径 1 层：地上拾取', badge: '升龙徽章' },
];

const moveOf = (slug: string) => getMove(slug)!;
---

<Layout
  title="技能机器获得方式"
  description="宝可梦水晶版全部 50 个 TM 与 7 个 HM 的获得方式：道馆奖励、商店售价、游戏角落兑换价格、拾取地点与 NPC 赠送条件"
>
  <h1>技能机器获得方式（TM50 + HM07）</h1>

  <Toc
    items={[
      { id: 'mechanism', label: '机制说明' },
      { id: 'tm-list', label: '招式机器 TM01–TM50' },
      { id: 'hm-list', label: '秘传机器 HM01–HM07' },
      { id: 'notes', label: '补充说明' },
    ]}
  >
  <section class="panel" id="mechanism">
    <p style="margin: 0">
      水晶版共有 <strong>50 个招式机器（TM）</strong>和 <strong>7 个秘传机器（HM）</strong>。
      第二世代的 TM 是<strong>一次性消耗品</strong>，教完就消失；HM 则可以无限次教学，
      但对应的场外功能（砍树、冲浪等）需要持有指定徽章才能使用（见 HM 表右列）。
      TM 编号按水晶版排列，与第一世代完全不同（如第一世代 TM24 是十万伏特，水晶版 TM24 是龙息）。
      机器能教给哪些宝可梦，可点表中的招式名进入详情页查看。
    </p>
  </section>

  <section class="panel" id="tm-list">
    <h2>招式机器（TM01–TM50）</h2>
    <div class="table-scroll">
    <table class="tm-table">
      <thead>
        <tr>
          <th>编号</th>
          <th>招式</th>
          <th>获得方式</th>
        </tr>
      </thead>
      <tbody>
        {
          tms.map((t) => {
            const m = moveOf(t.move);
            return (
              <tr>
                <td class="no">{t.no}</td>
                <td class="move-cell">
                  <a href={`/moves/${m.id}/`}>{m.nameZh}</a>
                  <TypeBadge type={m.type} />
                </td>
                <td class="obtain">
                  {t.obtain}
                  {t.extra && <div class="note">{t.extra}</div>}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
    </div>
  </section>

  <section class="panel" id="hm-list">
    <h2>秘传机器（HM01–HM07）</h2>
    <div class="table-scroll">
    <table class="tm-table">
      <thead>
        <tr>
          <th>编号</th>
          <th>招式</th>
          <th>获得方式</th>
          <th>场外使用条件</th>
        </tr>
      </thead>
      <tbody>
        {
          hms.map((h) => {
            const m = moveOf(h.move);
            return (
              <tr>
                <td class="no">{h.no}</td>
                <td class="move-cell">
                  <a href={`/moves/${m.id}/`}>{m.nameZh}</a>
                  <TypeBadge type={m.type} />
                </td>
                <td class="obtain">{h.obtain}</td>
                <td class="badge-cell">{h.badge}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
    </div>
  </section>

  <section class="panel" id="notes">
    <h2>补充说明</h2>
    <ul class="notes">
      <li>道馆奖励的 10 个 TM（城都 8 馆 + 关都莉佳、阿杏）的详细获得时机见<a href="/guides/gym-leaders/">道馆馆主对战数据</a>；小椿的 TM24 在龙穴发放，存在可拿两次的 BUG。</li>
      <li>喷射火焰 / 十万伏特 / 冰冻光束在水晶版<strong>没有 TM</strong>，只能找满金市的教学大叔学习（详见<a href="/guides/move-tutor/">招式传授 NPC</a>）；游戏角落兑换的打雷 / 暴风雪 / 大字爆是它们的上位版。</li>
      <li>满金百货店 5F 固定出售三个元素拳（各 ¥3000）；在你获得过 TM02 铁头功、TM08 碎岩后，柜台会加售这两枚（用掉后的补货途径）。</li>
      <li>满金百货店 5F 的周日接待员按<strong>队首宝可梦亲密度</strong>二选一赠送：150 以上给 TM27 报恩，低于 50 给 TM21 迁怒，中间则什么都不给；每个存档只能拿一次。</li>
      <li>玉虹游戏角落的兑换在奖品屋（隔壁建筑）进行：影子分身 1500、精神强念 3500、破坏光线 7500 代币。</li>
      <li>本页数据以水晶版反汇编（pokecrystal）的地图脚本、商店与兑换数据为准。</li>
    </ul>
  </section>
  </Toc>
</Layout>

<style>
  .tm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .tm-table th,
  .tm-table td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .tm-table th {
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
  }
  .no {
    font-weight: 600;
    white-space: nowrap;
  }
  .move-cell {
    white-space: nowrap;
  }
  .move-cell a {
    margin-right: 6px;
  }
  .obtain {
    white-space: normal;
    min-width: 280px;
  }
  .badge-cell {
    white-space: nowrap;
  }
  .note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
  }
  .notes {
    margin: 0;
    padding-left: 20px;
    font-size: 14px;
  }
  .notes li {
    margin: 6px 0;
  }
</style>
