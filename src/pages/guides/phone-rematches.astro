const poke = (id: number) => getPokemon(id)!;
---

<Layout
  title="电话约战 NPC 一览"
  description="宝可梦水晶版全部 28 位可登记电话的训练家：地点、初遇与最强再战队伍、大量出现与赠送道具等特殊来电"
>
  <h1>电话约战 NPC 一览（全 28 人）</h1>

  <Toc
    items={[
      { id: 'mechanism', label: '机制说明' },
      { id: 'list', label: '训练家一览（28）' },
      { id: 'notes', label: '补充说明' },
    ]}
  >
  <section class="panel" id="mechanism">
    <p style="margin: 0">
      水晶版中，战胜部分训练家后再次对话，可以把对方登记进<strong>宝可齿轮的电话簿</strong>（上限 10 个号码，
      登满需先删除才能再加）。全作共有 <strong>28</strong> 位这样的训练家，其中 <strong>24</strong>
      位会不定时来电约战——接到约战电话后，<strong>回到对方所在地点与其对话</strong>即可再战，经验值照常获得，
      是中后期稳定的练级手段。再战队伍分档变强：每打赢一次解锁下一档，更高档位还需推进剧情
      （抵达满金市/浅葱市、解决满金广播塔事件、战胜四天王、修复无人发电厂）才会开放，
      表中“最强再战队伍”即各人的最高档。除约战外，不少人还会来电赠送道具或通报大量出现情报（见最右列）；
      杂耍艺人迈克、宝可梦迷美江春／惠、空手道王武德四人<strong>不会再战</strong>，登记他们只为了赠礼或彩蛋。
      水晶版没有官方中文版，表中人名按日版原名译成中文（日版/美版原名附在中文名下方）。
    </p>
  </section>

  <section class="panel" id="list">
    <div class="table-scroll">
    <table class="phone-table">
      <thead>
        <tr>
          <th>地点</th>
          <th>训练家</th>
          <th>初遇队伍</th>
          <th>最强再战队伍</th>
          <th>特殊来电</th>
        </tr>
      </thead>
      <tbody>
        {
          contacts.map((c) => (
            <tr>
              <td>{c.location}</td>
              <td>
                {c.cls} {NAME_ZH[c.name] ?? c.name}
                <div class="note">日版 {NAME_JA[c.name] ?? ''} · 美版 {c.name}</div>
                {c.note && <div class="note">{c.note}</div>}
              </td>
              <td>
                <span class="team">
                  {c.first.map((m) => {
                    const pk = poke(m.id);
                    return (
                      <a class="member" href={`/pokemon/${m.id}/`} title={pk.nameZh ?? ''}>
                        <img src={`/sprites/normal/${m.id}.png`} alt={pk.nameZh ?? ''} />
                        <span>Lv{m.lv}</span>
                      </a>
                    );
                  })}
                </span>
              </td>
              <td>
                {c.max ? (
                  <span class="team">
                    {c.max.map((m) => {
                      const pk = poke(m.id);
                      return (
                        <a class="member" href={`/pokemon/${m.id}/`} title={pk.nameZh ?? ''}>
                          <img src={`/sprites/normal/${m.id}.png`} alt={pk.nameZh ?? ''} />
                          <span>Lv{m.lv}</span>
                        </a>
                      );
                    })}
                  </span>
                ) : (
                  <span class="no-rematch">不能再战</span>
                )}
              </td>
              <td class="special">
                {c.specialItems && (
                  <span class="item-row">
                    {c.specialItems.map((name) => {
                      const it = getItem(name);
                      return (
                        it?.sprite && (
                          <img class="item-icon" src={it.sprite} alt={it.nameZh ?? it.nameEn} title={it.nameZh ?? it.nameEn} />
                        )
                      );
                    })}
                  </span>
                )}
                {c.special}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    </div>
  </section>

  <section class="panel" id="notes">
    <h2>补充说明</h2>
    <ul class="notes">
      <li>妈妈、空木博士、正辉、自行车店、布耶娜（满金电台）等也能登记电话号码，但没有任何对战功能，故未列入表中。</li>
      <li>劲敌（小银）不靠电话约战：在月见山击败他之后，<strong>每周一和周三</strong>他会出现在石英高原宝可梦中心门口，可各再战一次。</li>
      <li>赠送进化石/道具类的来电（瑞穗、莉香、实、学、千里、英二、秀典、浩一、美江春、惠）在领过一次后仍会以较低概率再次触发，可以反复领取；增强剂类（五郎、元气、元弘、太郎、惠美）只在首次打赢最高档时赠送一次。</li>
      <li>大量出现来电每天每人最多一次，接到后当天内生效：康明的千针鱼要用钓竿在 32 号道路垂钓；勉的土龙弟弟在黑暗洞窟；洋太的蜻蜻蜓在 35 号道路草丛。大量出现也是获得这三种稀有宝可梦最省事的办法。</li>
      <li>队伍中带着特定宝可梦才肯留号码的有三位：惠要玛力露、美江春要皮卡丘、千里要皮皮。</li>
      <li>本页数据以水晶版反汇编（pokecrystal）的电话脚本与地图脚本为准；其中迈克、美江春、惠、武德四人在水晶版里没有再战脚本，与部分沿用金银资料的旧攻略不同。</li>
    </ul>
  </section>
  </Toc>
</Layout>

<style>
  .phone-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .phone-table th,
  .phone-table td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .phone-table th {
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
  }
  .team {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .member {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
  }
  .member:hover {
    color: var(--accent);
  }
  .member img {
    width: 44px;
    height: 44px;
    image-rendering: pixelated;
    object-fit: contain;
  }
  .no-rematch {
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
  }
  .phone-table td.special {
    white-space: normal;
    min-width: 220px;
  }
  .item-row {
    display: inline-flex;
    gap: 4px;
    margin-right: 6px;
    vertical-align: middle;
  }
  .item-icon {
    width: 24px;
    height: 24px;
    image-rendering: pixelated;
    object-fit: contain;
  }
  .note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
    white-space: normal;
  }
  .notes {
    margin: 0;
    padding-left: 20px;
    font-size: 14px;
  }
  .notes li {
    margin: 6px 0;
  }
</style>
